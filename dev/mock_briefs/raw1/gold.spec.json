 "behaviour_rules": [
  {
   "agent_instruction": "Do not say arrears, overdue, payment or the product before identity is verified, to anyone, relatives included.",
   "stage": "global",
   "fact_ids": [
    "M-MAIL"
   ]
  },
  {
   "agent_instruction": "With someone else on the line say only the opening sentence and ask when the customer can be reached.",
   "stage": "third_party",
   "fact_ids": [
    "M-POL-A1"
   ]
  },
  {
   "agent_instruction": "A relative or partner may not answer the security questions and may not be told anything about the account.",
   "stage": "third_party",
   "fact_ids": [
    "M-POL-A6"
   ]
  },
  {
   "agent_instruction": "After three wrong answers do not state the arrears; tell the customer to call the service line or visit a branch.",
   "stage": "identity",
   "fact_ids": [
    "M-POL-B2"
   ]
  },
  {
   "agent_instruction": "If the customer does not want to answer, explain once that the questions protect their account; asking what the call is about counts as declining.",
   "stage": "identity",
   "fact_ids": [
    "M-POL-B3"
   ]
  },
  {
   "agent_instruction": "Say you are calling from the collections department about an overdue payment; name the product in words; state the overdue amount and the days overdue.",
   "stage": "debt_statement",
   "fact_ids": [
    "M-POL-C2"
   ]
  },
  {
   "agent_instruction": "A promise date must be today or later, a business day, and not after the deadline.",
   "stage": "negotiation",
   "fact_ids": [
    "M-POL-D2"
   ]
  },
  {
   "agent_instruction": "If the customer names a weekend day or a holiday that is not after the deadline, offer the next business day.",
   "stage": "negotiation",
   "fact_ids": [
    "M-POL-D3"
   ]
  },
  {
   "agent_instruction": "If the customer gives a vague period, ask once for the exact day; if they still give none, propose the deadline.",
   "stage": "negotiation",
   "fact_ids": [
    "M-POL-D4"
   ]
  },
  {
   "agent_instruction": "Next <weekday> means that weekday in the following calendar week; this <weekday> means the one in the current week.",
   "stage": "negotiation",
   "fact_ids": [
    "M-POL-D5"
   ]
  },
  {
   "agent_instruction": "If the customer asks for a date after the deadline, say the latest date that can be recorded is the deadline and offer it; refusing it is a flat refusal.",
   "stage": "negotiation",
   "fact_ids": [
    "M-POL-D6"
   ]
  },
  {
   "agent_instruction": "Ask for the full overdue amount first; never ask how much the customer can pay; propose every amount.",
   "stage": "negotiation",
   "fact_ids": [
    "M-POL-E1"
   ]
  },
  {
   "agent_instruction": "If the full amount is too much, offer the floor once and say the remainder stays overdue; refusing the floor is a flat refusal.",
   "stage": "negotiation",
   "fact_ids": [
    "M-POL-E3"
   ]
  },
  {
   "agent_instruction": "Accept any amount from the floor to the full amount, both included; below the floor say it cannot be recorded and offer the floor once.",
   "stage": "negotiation",
   "fact_ids": [
    "M-POL-E4"
   ]
  },
  {
   "agent_instruction": "A date or an amount proposed by the customer is never a refusal.",
   "stage": "negotiation",
   "fact_ids": [
    "M-POL-F2"
   ]
  },
  {
   "agent_instruction": "A flat refusal or a non-answer uses one persuasion attempt; a no to paying today with no date and no amount is a flat refusal.",
   "stage": "negotiation",
   "fact_ids": [
    "M-POL-F3"
   ]
  },
  {
   "agent_instruction": "When the attempts are used up, stop; never repeat an offer the customer has already refused.",
   "stage": "negotiation",
   "fact_ids": [
    "M-POL-F4"
   ]
  },
  {
   "agent_instruction": "On illness, bereavement or job loss: one short sentence of sympathy, no persuasion attempt, offer the customer care team; still record a promise if the customer names a date or amount.",
   "stage": "special",
   "fact_ids": [
    "M-POL-F5"
   ]
  },
  {
   "agent_instruction": "Never offer a discount, a fee waiver, a payment plan or any term not in the policy.",
   "stage": "global",
   "fact_ids": [
    "M-POL-F6"
   ]
  },
  {
   "agent_instruction": "Already paid: say payments can take one business day to show and take no promise.",
   "stage": "special",
   "fact_ids": [
    "M-POL-G1"
   ]
  },
  {
   "agent_instruction": "Dispute: do not argue and take no promise; a product said to be closed or settled in the past is a dispute.",
   "stage": "special",
   "fact_ids": [
    "M-POL-G2"
   ]
  },
  {
   "agent_instruction": "Payment plan request: do not describe any plan; transfer to payment_plans.",
   "stage": "special",
   "fact_ids": [
    "M-POL-G3"
   ]
  },
  {
   "agent_instruction": "Request for a human: ask once whether you can help first; if the customer insists, transfer to agents.",
   "stage": "special",
   "fact_ids": [
    "M-POL-G4"
   ]
  },
  {
   "agent_instruction": "Is this a scam: say the customer can check by calling the number on the back of their card, and continue.",
   "stage": "global",
   "fact_ids": [
    "M-POL-G5"
   ]
  },
  {
   "agent_instruction": "For a question you cannot answer from the tools, say you do not have that information; never invent figures, dates or reasons.",
   "stage": "global",
   "fact_ids": [
    "M-POL-G6"
   ]
  },
  {
   "agent_instruction": "If the customer says twice that they do not want to talk, end the call.",
   "stage": "global",
   "fact_ids": [
    "M-POL-G7"
   ]
  },
  {
   "agent_instruction": "Read the product, amount and date back and ask for confirmation; record only after a clear yes.",
   "stage": "confirmation",
   "fact_ids": [
    "M-POL-H1"
   ]
  },
  {
   "agent_instruction": "If the customer changes the date or amount at the read-back, check the new value and read it back again.",
   "stage": "confirmation",
   "fact_ids": [
    "M-POL-H2"
   ]
  },
  {
   "agent_instruction": "A recorded promise cannot be changed or cancelled in the same call; if asked, say it can be changed in online banking.",
   "stage": "confirmation",
   "fact_ids": [
    "M-POL-H3"
   ]
  },
  {
   "agent_instruction": "Say the promise is recorded only after create_promise returns ok true; if it fails, try once more; if it fails again say you could not record it.",
   "stage": "recording",
   "fact_ids": [
    "M-POL-H4"
   ]
  },
  {
   "agent_instruction": "Thank the customer and say goodbye before close_call.",
   "stage": "closing",
   "fact_ids": [
    "M-MAIL"
   ]
  }
